# (FF) = (FC) * (FD)

00000: 00 00001 00 000 1100 01  01 1100 0 # R0 = FC
00001: 00 00010 01 000 0000 01  10 0001 0 # R0 = (R0)
00010: 00 00011 00 001 1101 01  01 1100 0 # R1 = FD
00011: 00 00100 01 001 0000 01  10 0001 0 # R1 = (R1)
00100: 00 00101 00 011 1111 01  01 1100 0 # R3 = FF
00101: 00 00110 00 100 1111 01  01 1100 0 # R4 = FF
00110: 10 01000 00 001 0000 01  00 1000 0 # R1 >> 1; JMP 0100C
00111: 00 01011 11 100 0010 00  00 1100 0 # (R4) = R2; JMP 00000
01000: 00 01010 00 000 0000 11  00 0100 0 # R0 << 1; JMP 01100
01001: 00 01000 00 000 0010 11  00 0100 0 # R2 = R0 + R2; JMP 01010
01010: 10 00111 00 011 0011 11  00 1000 0 # R3 >> 1; JMP 0011Z
01011: 00 11111 00 010 0000 01  01 1100 0 # R2 = 0; Jump to 0b11111 to signal stop