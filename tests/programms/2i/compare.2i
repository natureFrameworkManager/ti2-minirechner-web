# (FE) = 0xFF, (FF) = 0x00 if (FC) >= (FD)
# (FE) = 0x00, (FF) = 0xFF if (FC) <  (FD)

00000: 00 00001 00 000 1100 01  01 1100 0 # R0 = FC
00001: 00 00010 01 000 0000 01  10 0001 0 # R0 = (R0)
00010: 00 00011 00 001 1101 01  01 1100 0 # R1 = FD
00011: 00 00100 01 001 0000 01  10 0001 0 # R1 = (R1)
00100: 00 00101 00 010 1111 01  01 1100 0 # R2 = FF
00101: 00 00110 00 011 1110 01  01 1100 0 # R3 = FE
00110: 00 00111 00 001 0001 01  00 0010 0 # R1 = COM R1
00111: 11 01000 00 000 0001 01  00 0101 0 # R0 = ADDS R0 R1; JMP 0100N
01000: 00 01010 11 011 0010 00  00 1100 0 # x >= y; (R3) = R2
01001: 00 01011 11 010 0010 00  00 1100 0 # x < y; (R2) = R2
01010: 00 11111 11 010 0000 00  01 1100 0 # x < y; (R2) = R7; Jump to 0b11111 to signal stop
01011: 00 11111 11 011 0000 00  01 1100 0 # x < y; (R3) = R7; Jump to 0b11111 to signal stop